        "fmt": "oxfmt --check",
        "fmt:fix": "oxfmt",
        "check": "npm run lint && npm run fmt && npm run typecheck && npm test"
    },
    "dependencies": {
        "@hapi/boom": "^11.0.0-rc.0"
    },
    "devDependencies": {
        "@hapi/oxc-plugin": "^1.1.1",
        "@types/node": "^22.19.20",
        "@vitest/coverage-v8": "^5.0.5",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=22"
    }
