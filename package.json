{
    "name": "@hapi/cryptiles",
    "version": "6.0.3",
    "description": "General purpose crypto utilities",
    "keywords": [
        "cryptography",
        "security",
        "utilites"
    ],
    "license": "BSD-3-Clause",
    "repository": "git://github.com/hapijs/cryptiles",
    "files": [
        "src",
        "API.md"
    ],
    "type": "module",
    "types": "src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.js"
        }
    },
    "scripts": {
        "test": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
